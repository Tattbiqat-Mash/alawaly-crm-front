# Server-only (never NEXT_PUBLIC_): the BFF forwards /bff/* to ${API_BASE_URL}/api/v2/*.
API_BASE_URL=https://system.alawaly.tattbiqat.com

# Server-only: where stored media paths (projects/x/cover.jpg) are served; /bff/media/* redirects there.
# Defaults to https://alawaly.tattbiqat.com/public/storage (where the live API's images are).
MEDIA_BASE_URL=

# Set to 1 to answer from the recorded Frontend Guide examples instead of the real API
# (tests, offline development). Leave empty to use the real API.
API_MOCKS=
